# Run python scripts/setup.py to generate real local credentials in .env.
POSTGRES_PASSWORD=generate-with-setup-script
RABBITMQ_PASSWORD=generate-with-setup-script
ADMIN_KEY=generate-with-setup-script
# Optional settings; keep the default loopback binding for local use.
BIND_ADDRESS=127.0.0.1
PORT=18080
# On Linux, setup.py also records LOCAL_UID/LOCAL_GID so load results are writable.
